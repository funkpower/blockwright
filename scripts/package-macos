#!/usr/bin/env bash
# Builds Blockwright.app and the disk image people drag it from (run on a Mac).
#
#   scripts/package-macos [--qt DIR] [--deps DIR] [--work DIR] [--out DIR]
#                         [--help-bundle DIR | --no-help-bundle]
#
#   --qt    Qt 6 for macOS: the directory holding bin/macdeployqt and
#           lib/cmake/Qt6 (default: $BW_QT_PREFIX)
#   --deps  static libzip and zstd, built there by scripts/macos-deps if they
#           aren't yet (default: $BW_MACOS_DEPS, else <work>/deps)
#   --work  build tree, staging and tools (default: $BW_PACKAGE_WORK, else
#           ~/.cache/dw/blockwright-macos-build)
#   --out   where the dmg goes (default: dist/ in the repo)
#   --help-bundle DIR  the help bundle to install (scripts/help-bundle; #210);
#            default: the source tree's help/, which a release tarball holds
#   --no-help-bundle   none: Help opens the website
#
# Environment: CMAKE_OSX_ARCHITECTURES (default this Mac's; "arm64;x86_64"
# makes a universal app, with a universal Qt), MACOSX_DEPLOYMENT_TARGET
# (default the project's, CMAKE_OSX_DEPLOYMENT_TARGET in CMakeLists.txt),
# JOBS (default 8).
#
# The deployment target is the oldest macOS the app claims: its
# LSMinimumSystemVersion, the cask's depends_on macos and what every binary in
# the bundle is built for. A Qt built for a newer macOS (Qt 6.10 and later
# need macOS 13) is refused before anything is built; build with the Qt
# packaging/RELEASING.md names, or raise the target.
#
# The app carries the notices for the Qt, libzip and zstd it bundles in
# Contents/Resources/doc (packaging/macos/third-party). Qt's SBOMs come from
# <qt>/sbom, so use Qt's own build, which has them.
#
# Writes <out>/Blockwright-<version>.dmg, its .sha256, and blockwright.rb, the
# Homebrew cask for it (packaging/README.md says how to publish). The app is
# signed ad hoc: from a download, Gatekeeper blocks the first run of the app
# and of the CLI inside it until the quarantine flag is removed.
set -euo pipefail

die() { echo "package-macos: $*" >&2; exit 1; }
[[ $(uname -s) == Darwin ]] || die "run this on a Mac"
root=$(cd "$(dirname "$0")/.." && pwd)

# minos <Mach-O> <arch>: the oldest macOS that slice is built for, from
# LC_BUILD_VERSION (or LC_VERSION_MIN_MACOSX in an older binary); empty if it
# has neither. awk reads to the end: exiting early could kill otool with
# SIGPIPE, and pipefail would end the script with no message.
minos() {
  otool -arch "$2" -l "$1" 2>/dev/null | awk '
    / cmd LC_BUILD_VERSION$/ { b = 1; next }
    / cmd LC_VERSION_MIN_MACOSX$/ { m = 1; next }
    / cmd / { b = m = 0 }
    b && $1 == "minos" && v == "" { v = $2 }
    m && $1 == "version" && v == "" { v = $2 }
    END { if (v != "") print v }'
}
# newer <a> <b>: true if macOS version a is newer than b (12.0 = 12 = 12.0.0)
newer() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".")
    for (i = 1; i <= 3; i++) { if (x[i] + 0 != y[i] + 0) exit !(x[i] + 0 > y[i] + 0) }
    exit 1 }'
}

qt=${BW_QT_PREFIX:-}
deps=${BW_MACOS_DEPS:-}
work=${BW_PACKAGE_WORK:-$HOME/.cache/dw/blockwright-macos-build}
out=$root/dist
help=
no_help=
while [[ $# -gt 0 ]]; do
  case $1 in
    --qt) qt=$2; shift 2 ;;
    --deps) deps=$2; shift 2 ;;
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --help-bundle) help=$2; shift 2 ;;
    --no-help-bundle) no_help=1; shift ;;
    -h|--help) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument $1 (see --help)" ;;
  esac
done
[[ -n $qt ]] || die "say where Qt is: --qt DIR or BW_QT_PREFIX"
[[ -x $qt/bin/macdeployqt && -d $qt/lib/cmake/Qt6 ]] || die "$qt has no bin/macdeployqt and lib/cmake/Qt6"
qt=$(cd "$qt" && pwd)
# The help bundle (#210): --help-bundle, else the tarball's help/, else
# refused unless --no-help-bundle
if [[ -n $help && -n $no_help ]]; then
  die "--help-bundle and --no-help-bundle: one or the other"
elif [[ -n $no_help ]]; then
  help=
elif [[ -z $help && -f $root/help/bundle.json ]]; then
  help=$root/help
elif [[ -z $help ]]; then
  die "no help bundle: build from a release tarball (its help/), or pass --help-bundle DIR (scripts/help-bundle) or --no-help-bundle"
fi
if [[ -n $help ]]; then
  [[ -f $help/bundle.json ]] || die "--help-bundle $help: no bundle.json there"
  help=$(cd "$help" && pwd)
fi
archs=${CMAKE_OSX_ARCHITECTURES:-$(uname -m)}
project_target=$(sed -n 's/^[[:space:]]*set([[:space:]]*CMAKE_OSX_DEPLOYMENT_TARGET[[:space:]]\{1,\}"\{0,1\}\([0-9][0-9.]*\)"\{0,1\}[[:space:])].*/\1/p' "$root/CMakeLists.txt")
[[ -n $project_target ]] || die "no CMAKE_OSX_DEPLOYMENT_TARGET in $root/CMakeLists.txt"
target=${MACOSX_DEPLOYMENT_TARGET:-$project_target}
[[ $target =~ ^[0-9]+(\.[0-9]+){0,2}$ ]] || die "MACOSX_DEPLOYMENT_TARGET $target is not a macOS version"

# A Qt built for a newer macOS than the target links with only a warning and
# makes an app that claims a macOS it can't start on: refuse it now, before
# the long build.
for tool in otool lipo; do
  command -v "$tool" >/dev/null || die "$tool is not on PATH"
done
qtcore=$qt/lib/QtCore.framework/QtCore
[[ -f $qtcore ]] || die "$qt has no lib/QtCore.framework/QtCore"
for arch in ${archs//;/ }; do
  lipo "$qtcore" -verify_arch "$arch" 2>/dev/null || die "$qtcore has no $arch slice"
  qt_minos=$(minos "$qtcore" "$arch")
  [[ -n $qt_minos ]] || die "$qtcore ($arch) says no minimum macOS"
  if newer "$qt_minos" "$target"; then
    die "the Qt in $qt needs macOS $qt_minos (QtCore's minos, $arch), but the app's deployment target is macOS $target.
The app would claim macOS $target and not start there. Build with the Qt that
packaging/RELEASING.md names (Qt 6.8.3, which runs on macOS 12), or raise the
target (MACOSX_DEPLOYMENT_TARGET=$qt_minos, or CMAKE_OSX_DEPLOYMENT_TARGET in
CMakeLists.txt to change what every build supports)."
  fi
done
for tool in cmake ninja python3 codesign hdiutil install_name_tool; do
  command -v "$tool" >/dev/null || die "$tool is not on PATH"
done
mkdir -p "$work" "$out"
work=$(cd "$work" && pwd)
out=$(cd "$out" && pwd)
deps=${deps:-$work/deps}
jobs=${JOBS:-8}

echo "== libzip and zstd ($archs, macOS $target)"
CMAKE_OSX_ARCHITECTURES=$archs MACOSX_DEPLOYMENT_TARGET=$target JOBS=$jobs "$root/scripts/macos-deps" "$deps"
deps=$(cd "$deps" && pwd)

echo "== build"
build=$work/build stage=$work/stage
cmake -S "$root" -B "$build" -G Ninja -DBW_HELP_BUNDLE="$help" -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
  -DBLOCKWRIGHT_MACOS_BUNDLE=ON -DCMAKE_OSX_ARCHITECTURES="$archs" -DCMAKE_OSX_DEPLOYMENT_TARGET="$target" \
  -DCMAKE_PREFIX_PATH="$qt;$deps" -DCMAKE_INSTALL_PREFIX="$stage" >/dev/null
nice -n 10 cmake --build "$build" -j "$jobs"
version=$(sed -n 's/^CMAKE_PROJECT_VERSION:[A-Z]*=//p' "$build/CMakeCache.txt")
[[ -n $version ]] || die "no project version in $build/CMakeCache.txt"
rm -rf "$stage"
cmake --install "$build" >/dev/null
app=$stage/Blockwright.app
[[ -x $app/Contents/MacOS/Blockwright && -x $app/Contents/MacOS/blockwright-cli ]] || die "the install left no $app"
[[ -z $help || -f $app/Contents/Resources/blockwright/help/bundle.json ]] || die "the install left out the help bundle"
plist_min=$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' "$app/Contents/Info.plist" 2>/dev/null) || true
[[ $plist_min == "$target" ]] || die "the app's LSMinimumSystemVersion is ${plist_min:-missing}, not the target $target"

echo "== Qt into the bundle"
"$qt/bin/macdeployqt" "$app" -executable="$app/Contents/MacOS/blockwright-cli" -always-overwrite
# --list-actions and --screenshot run the window on the offscreen platform,
# with no display; macdeployqt deploys only the cocoa one.
cp "$qt/plugins/platforms/libqoffscreen.dylib" "$app/Contents/PlugIns/platforms/"
# Qt's build is universal; an app for one architecture carries only that
# architecture's slice of it.
if [[ $archs != *";"* ]]; then
  find "$app/Contents/Frameworks" "$app/Contents/PlugIns" -type f | while read -r f; do
    file -b "$f" | grep -q '^Mach-O universal' || continue
    lipo "$f" -thin "$archs" -output "$f.thin" && cat "$f.thin" > "$f" && rm "$f.thin"
  done
fi
# The build's own search paths into the Qt install go: the bundle loads Qt
# from Contents/Frameworks.
for bin in "$app/Contents/MacOS/Blockwright" "$app/Contents/MacOS/blockwright-cli"; do
  otool -l "$bin" | awk '/cmd LC_RPATH/ { r = 1 } r && /^ *path / { print $2; r = 0 }' | while read -r rp; do
    [[ $rp == @* ]] || install_name_tool -delete_rpath "$rp" "$bin"
  done
done
# Nothing in the bundle may load a library from outside it but the system's
# (/usr/lib, /System): not the Qt install, the build, or a Homebrew prefix.
leaks=$(find "$app" -type f -perm -u+x -o -type f -name '*.dylib' | while read -r f; do
  file -b "$f" | grep -q Mach-O || continue
  otool -L "$f" | awk -F'\t' 'NF > 1 { sub(/ \(compatibility.*/, "", $2); print $2 }' |
    grep -E '^/' | grep -vE '^/(usr/lib|System)/' | sed "s|^|$f: |" || true
  otool -l "$f" | awk '/cmd LC_RPATH/ { r = 1 } r && /^ *path / { print $2; r = 0 }' | grep -E "^/" | sed "s|^|$f: rpath |" || true
done)
[[ -z $leaks ]] || die "the bundle loads libraries from outside it:"$'\n'"$leaks"
# Nothing in it may need a newer macOS than LSMinimumSystemVersion says: not a
# Qt plugin, libzip or zstd, or the programs.
too_new=$(find "$app" -type f -perm -u+x -o -type f -name '*.dylib' | while read -r f; do
  file -b "$f" | grep -q Mach-O || continue
  for arch in ${archs//;/ }; do
    m=$(minos "$f" "$arch")
    if [[ -z $m ]]; then echo "$f ($arch): no minimum macOS"
    elif newer "$m" "$target"; then echo "$f ($arch): macOS $m"; fi
  done
done)
[[ -z $too_new ]] || die "the bundle has code for a newer macOS than $target:"$'\n'"$too_new"

echo "== notices"
# Qt's notice with its version, frameworks, plugins and source link, the LGPL,
# Qt's SBOMs and the libzip and zstd licences, into Contents/Resources/doc
# before signing seals them in
"$root/packaging/macos/third-party" "$qt" "$deps" "$app"

echo "== sign (ad hoc)"
# Inside out: libraries and frameworks, then the CLI, then the app.
find "$app/Contents/Frameworks" "$app/Contents/PlugIns" -name '*.dylib' -type f -print0 |
  xargs -0 -n 1 codesign --force --sign - --timestamp=none
find "$app/Contents/Frameworks" -maxdepth 1 -name '*.framework' -print0 |
  xargs -0 -n 1 codesign --force --sign - --timestamp=none
codesign --force --sign - --timestamp=none "$app/Contents/MacOS/blockwright-cli"
codesign --force --sign - --timestamp=none "$app"
codesign --verify --deep --strict "$app"

echo "== disk image"
venv=$work/dmgbuild-venv
if [[ ! -x $venv/bin/dmgbuild ]]; then
  python3 -m venv "$venv"
  "$venv/bin/pip" install --quiet "dmgbuild==1.6.7"
fi
dmg=$out/Blockwright-$version.dmg
rm -f "$dmg" "$dmg.sha256"
"$venv/bin/dmgbuild" -s "$root/packaging/macos/dmg-settings.py" -D app="$app" \
  -D background="$root/packaging/macos/dmg-background.png" "Blockwright $version" "$dmg"
hdiutil verify "$dmg" >/dev/null
sha=$(shasum -a 256 "$dmg" | cut -d' ' -f1)
printf '%s  %s\n' "$sha" "$(basename "$dmg")" > "$dmg.sha256"

# The cask: one architecture's dmg says so; a universal one runs on either.
case ${target%%.*} in
  11) macos=big_sur ;; 12) macos=monterey ;; 13) macos=ventura ;; 14) macos=sonoma ;;
  15) macos=sequoia ;; 26) macos=tahoe ;; *) die "no Homebrew name for macOS $target" ;;
esac
case $archs in
  arm64) arch_line='  depends_on arch: :arm64' ;;
  x86_64) arch_line='  depends_on arch: :x86_64' ;;
  *) arch_line= ;;
esac
sed -e "s/@VERSION@/$version/" -e "s/@SHA256@/$sha/" \
  -e "s/@MACOS@/$macos/" \
  -e "s/@ARCH@/$arch_line/" "$root/packaging/homebrew/blockwright.rb.in" | cat -s > "$out/blockwright.rb"

echo "== done"
echo "$dmg ($(du -h "$dmg" | cut -f1 | tr -d ' '), sha256 $sha)"
echo "$out/blockwright.rb"
