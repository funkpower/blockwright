#!/usr/bin/env python3
"""Generate core/src/width.inc, the cell width of every code point (PLAN §16).

    gen-width VERSION [--floor FLOOR] [--receivers LIST] [-o FILE] [--ucd DIR]
        Writes the table for Unicode VERSION (18.0.0, say) to FILE
        (core/src/width.inc by default), with the code points whose width
        varies between FLOOR (9.0.0 by default, the version that made emoji
        wide) and VERSION, for lint's width-varies, and the receiver versions
        in which each code point joins the one before it, for the .txt
        budget. LIST is the older Unicode versions a .txt's receiver may have,
        comma-separated (by default 14.0.0,15.0.0,15.1.0,16.0.0,17.0.0, those
        of Python 3.11, 3.12, 3.13, 3.14 and 3.15).
    gen-width VERSION --check-libc LIBC_VERSION [--ucd DIR]
        Compares the table with the host C library's wcwidth (C.UTF-8) for
        every code point, LIBC_VERSION being the Unicode version that C
        library builds its table from (17.0.0 for glibc 2.44). Every
        difference must be one of PLAN §16's deliberate ones (U+0000, which a
        cell holds as a blank, U+3248-324F, code points VERSION leaves
        unassigned) or one the two Unicode versions give differently (the
        table built from LIBC_VERSION agrees with the C library there).
        Prints a summary; exits 1 on any other difference.

The UCD files are read from DIR/<VERSION>/, or downloaded from unicode.org
into ~/.cache/blockwright/ucd/<VERSION>/ the first time.

The rules are glibc's localedata/unicode-gen ones, first match wins:
  -1  the controls a cell refuses: U+0001-001F, U+007F, the C1 controls
      U+0080-009F, U+2028 and U+2029; and the surrogates
   1  U+0000 (a cell's blank), U+00AD
   2  U+115F
   0  Hangul jamo of syllable type V or T, general categories Mn and Me,
      Default_Ignorable_Code_Point
   1  U+3248-324F (Ambiguous; glibc gives them 2)
   2  East Asian Width W or F, the unassigned code points taking the
      defaults EastAsianWidth.txt states (@missing)
   1  everything else

A receiver that takes zero width from its own Unicode's categories (the
WeeChat ascii script, from its Python's unicodedata) joins a code point to the
one before it when that Unicode's UnicodeData.txt gives it general category Mn
or Me (from U+0300 on), or when it is Default_Ignorable_Code_Point or a Hangul
jamo V or T as VERSION has them, but for U+00AD and U+115F (the script's
fixed ranges). Each receiver
version's own categories decide, not VERSION's filtered by age, so a code point
that stopped being a mark (U+1171E, Mn until 15.1 and Mc from 16.0) joins under
the versions that had it as one. The join mask of a code point has a bit for
each receiver version and VERSION, in order, and one more for a version later
than VERSION: set for a code point VERSION leaves unassigned (not a
noncharacter), otherwise as VERSION's. That bit is a cheap hedge: no receiver
in LIST needs it, and it doesn't make a line safe whatever a later version
assigns. Only the code points whose mask is neither empty nor full are listed;
for every other one it is full exactly where the width table is 0, which the
generator checks.

A code point's width varies when it is 0 or 2 under VERSION and either
DerivedAge.txt has it assigned after FLOOR (or not at all) or the same rules
over FLOOR's UCD give it another width: a terminal or IRC client built on an
older table may draw it in another number of columns.
"""

import argparse
import ctypes
import os
import re
import sys
import urllib.request

FILES = [
    "UnicodeData.txt",
    "EastAsianWidth.txt",
    "DerivedCoreProperties.txt",
    "HangulSyllableType.txt",
    "DerivedAge.txt",
]
MAX = 0x10FFFF


def ucd_dir(version, base):
    d = os.path.join(base or os.path.expanduser("~/.cache/blockwright/ucd"), version)
    os.makedirs(d, exist_ok=True)
    for f in FILES:
        path = os.path.join(d, f)
        if not os.path.exists(path):
            url = f"https://www.unicode.org/Public/{version}/ucd/{f}"
            sys.stderr.write(f"gen-width: fetching {url}\n")
            with urllib.request.urlopen(url) as r:
                data = r.read()
            with open(path + ".part", "wb") as out:
                out.write(data)
            os.replace(path + ".part", path)
    return d


def ranges(path):
    """(first, last, value) for each data line of a UCD property file."""
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            cps, value = [p.strip() for p in line.split(";")[:2]]
            a, _, b = cps.partition("..")
            yield int(a, 16), int(b or a, 16), value


def missing(path):
    """The @missing defaults of a UCD file, in file order."""
    with open(path, encoding="utf-8") as f:
        for line in f:
            m = re.match(r"#\s*@missing:\s*([0-9A-F]+)\.\.([0-9A-F]+)\s*;\s*(\w+)", line)
            if m:
                yield int(m.group(1), 16), int(m.group(2), 16), m.group(3)


def load(version, base):
    d = ucd_dir(version, base)
    gc = {}
    first = None
    with open(os.path.join(d, "UnicodeData.txt"), encoding="utf-8") as f:
        for line in f:
            fields = line.split(";")
            cp, name, cat = int(fields[0], 16), fields[1], fields[2]
            if name.endswith(", First>"):
                first = cp
                continue
            if name.endswith(", Last>"):
                for c in range(first, cp + 1):
                    gc[c] = cat
                continue
            gc[cp] = cat
    eaw = [None] * (MAX + 1)
    path = os.path.join(d, "EastAsianWidth.txt")
    for a, b, v in missing(path):  # later @missing lines override earlier ones
        eaw[a : b + 1] = [v] * (b - a + 1)
    for a, b, v in ranges(path):
        eaw[a : b + 1] = [v] * (b - a + 1)
    di = set()
    for a, b, v in ranges(os.path.join(d, "DerivedCoreProperties.txt")):
        if v == "Default_Ignorable_Code_Point":
            di.update(range(a, b + 1))
    vt = set()
    for a, b, v in ranges(os.path.join(d, "HangulSyllableType.txt")):
        if v in ("V", "T"):
            vt.update(range(a, b + 1))
    return gc, eaw, di, vt


def widths(version, base):
    gc, eaw, di, vt = load(version, base)
    out = [1] * (MAX + 1)
    for cp in range(MAX + 1):
        if 0x01 <= cp <= 0x1F or 0x7F <= cp <= 0x9F or cp in (0x2028, 0x2029) or 0xD800 <= cp <= 0xDFFF:
            w = -1
        elif cp in (0x0000, 0x00AD):
            w = 1
        elif cp == 0x115F:
            w = 2
        elif cp in vt or gc.get(cp) in ("Mn", "Me") or cp in di:
            w = 0
        elif 0x3248 <= cp <= 0x324F:
            w = 1
        elif eaw[cp] in ("W", "F"):
            w = 2
        else:
            w = 1
        out[cp] = w
    return out, gc


def ages(version, base):
    """The (major, minor) version DerivedAge.txt says each code point was assigned in."""
    out = {}
    for a, b, v in ranges(os.path.join(ucd_dir(version, base), "DerivedAge.txt")):
        age = tuple(int(n) for n in v.split(".")[:2])
        for cp in range(a, b + 1):
            out[cp] = age
    return out


def varies(version, floor, base, table):
    """(first, last) runs of the code points whose width varies since `floor`."""
    old, _ = widths(floor, base)
    age = ages(version, base)
    since = tuple(int(n) for n in floor.split(".")[:2])
    flags = [False] * (MAX + 2)
    for cp in range(MAX + 1):
        if table[cp] in (0, 2):
            a = age.get(cp)
            flags[cp] = a is None or a > since or old[cp] != table[cp]
    result = []
    start = None
    for cp in range(MAX + 2):
        if flags[cp] and start is None:
            start = cp
        elif not flags[cp] and start is not None:
            result.append((start, cp - 1))
            start = None
    return result


def mark_joins(version, receivers, base, table):
    """(first, last, mask) runs of the code points whose join mask (above)
    is neither empty nor full."""
    gc, _, di, vt = load(version, base)
    cats = [load(v, base)[0] for v in receivers] + [gc]
    later = 1 << len(cats)
    full = (later << 1) - 1
    flags = [0] * (MAX + 2)
    for cp in range(MAX + 1):
        if (cp in di or cp in vt) and cp not in (0x00AD, 0x115F):  # drawn 1 and 2 wide
            mask = full
        else:
            mask = 0
            for i, c in enumerate(cats):
                if cp >= 0x300 and c.get(cp) in ("Mn", "Me"):
                    mask |= 1 << i
            noncharacter = 0xFDD0 <= cp <= 0xFDEF or (cp & 0xFFFE) == 0xFFFE
            if cp not in gc and not noncharacter or mask & (later >> 1):
                mask |= later
        if mask in (0, full):
            if (mask == full) != (table[cp] == 0):
                sys.exit(f"gen-width: U+{cp:04X} joins under every version but isn't width 0, or the reverse")
        else:
            flags[cp] = mask
    result = []
    start = 0
    for cp in range(1, MAX + 2):
        if cp == MAX + 1 or flags[cp] != flags[start]:
            if flags[start]:
                result.append((start, cp - 1, flags[start]))
            start = cp
    return result


def runs(table):
    """(first, last, width) for each run of code points whose width isn't 1."""
    result = []
    start = 0
    for cp in range(1, MAX + 2):
        if cp == MAX + 1 or table[cp] != table[start]:
            if table[start] != 1:
                result.append((start, cp - 1, table[start]))
            start = cp
    return result


def write(version, floor, receivers, base, path):
    table, _ = widths(version, base)
    rs = runs(table)
    vs = varies(version, floor, base, table)
    ms = mark_joins(version, receivers, base, table)
    with open(path + ".part", "w", encoding="utf-8", newline="\n") as f:
        f.write(f"// Generated by scripts/gen-width {version} from the Unicode {version} UCD. Do not edit:\n")
        f.write("// run the script with a new version instead (PLAN §16, Width).\n")
        f.write("// The code points whose cell width isn't 1, as sorted, disjoint\n")
        f.write("// {first, last, width} runs: 0 (zero width), 2 (wide) or -1 (a control\n")
        f.write("// a cell refuses, or a surrogate).\n")
        f.write(f'inline constexpr char kWidthUnicodeVersion[] = "{version}";\n')
        f.write("inline constexpr WidthRun kWidthRuns[] = {\n")
        for a, b, w in rs:
            f.write(f"    {{0x{a:04X}, 0x{b:04X}, {w}}},\n")
        f.write("};\n")
        f.write(f"// The code points of width 0 or 2 whose width varies since Unicode {floor}:\n")
        f.write("// assigned after it (DerivedAge.txt), unassigned, or given another\n")
        f.write("// width by its UCD. Sorted, disjoint {first, last} runs.\n")
        f.write(f'inline constexpr char kWidthVariesFloor[] = "{floor}";\n')
        f.write("inline constexpr VariesRun kWidthVariesRuns[] = {\n")
        for a, b in vs:
            f.write(f"    {{0x{a:04X}, 0x{b:04X}}},\n")
        f.write("};\n")
        f.write("// The Unicode versions a .txt's receiver may have, oldest first, ending\n")
        f.write("// with the table's; a join mask has a bit for each in turn and one more\n")
        f.write("// for a later version.\n")
        names = ", ".join('"' + ".".join(v.split(".")[:2]) + '"' for v in receivers + [version])
        f.write(f"inline constexpr const char* kJoinUnicodes[] = {{{names}}};\n")
        f.write("// The code points that join the one before them under some of those\n")
        f.write("// versions and not others (Mn or Me in that version's own UnicodeData,\n")
        f.write("// or unassigned in the table's, for the later bit), with the mask of the\n")
        f.write("// versions they join under. Sorted, disjoint {first, last, mask} runs.\n")
        f.write("inline constexpr JoinRun kJoinRuns[] = {\n")
        for a, b, m in ms:
            f.write(f"    {{0x{a:04X}, 0x{b:04X}, 0x{m:02X}}},\n")
        f.write("};\n")
    os.replace(path + ".part", path)
    print(f"gen-width: {len(rs)} runs, {len(vs)} width-varies runs since {floor} and {len(ms)} join runs "
          f"over {', '.join(receivers)} for Unicode {version} written to {path}")


def check_libc(version, libc_version, base):
    libc = ctypes.CDLL(None)
    libc.setlocale.restype = ctypes.c_char_p
    if not libc.setlocale(6, b"C.UTF-8"):  # LC_ALL
        sys.exit("gen-width: no C.UTF-8 locale")
    wcwidth = libc.wcwidth
    wcwidth.argtypes = [ctypes.c_uint32]
    ours, gc = widths(version, base)
    old, old_gc = widths(libc_version, base)
    deliberate = {"U+0000": [], "U+3248-324F": [], f"unassigned in {version}": []}
    moved, unexpected = [], []
    for cp in range(MAX + 1):
        theirs = wcwidth(cp)
        if theirs == ours[cp]:
            continue
        if cp == 0:
            deliberate["U+0000"].append(cp)
        elif 0x3248 <= cp <= 0x324F:
            deliberate["U+3248-324F"].append(cp)
        elif cp not in gc and theirs == -1:
            deliberate[f"unassigned in {version}"].append(cp)
        elif old[cp] == theirs or (cp not in old_gc and theirs == -1):
            moved.append(cp)
        else:
            unexpected.append((cp, ours[cp], theirs))
    for k, v in deliberate.items():
        print(f"deliberate, {k}: {len(v)} code points")
    print(f"given differently by Unicode {libc_version} and {version}: {len(moved)} code points")
    for cp in moved[:40]:
        print(f"  U+{cp:04X}: ours {ours[cp]}, libc {wcwidth(cp)}, Unicode {libc_version} rules {old[cp]}")
    if len(moved) > 40:
        print(f"  ... and {len(moved) - 40} more")
    if unexpected:
        print(f"UNEXPECTED: {len(unexpected)} code points")
        for cp, a, b in unexpected[:100]:
            print(f"  U+{cp:04X}: ours {a}, libc {b}")
        return 1
    print("no other differences")
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("version", help="Unicode version, e.g. 18.0.0")
    p.add_argument("-o", "--output", default=None)
    p.add_argument("--ucd", default=None, help="directory holding <version>/ UCD files")
    p.add_argument("--check-libc", metavar="LIBC_VERSION", default=None)
    p.add_argument("--floor", default="9.0.0", help="the oldest Unicode version width-varies allows for")
    p.add_argument("--receivers", default="14.0.0,15.0.0,15.1.0,16.0.0,17.0.0",
                   help="the Unicode versions older than VERSION a .txt's receiver may have")
    a = p.parse_args()
    receivers = a.receivers.split(",")
    for v in (a.version, a.floor, *receivers):
        if not re.fullmatch(r"\d+\.\d+\.\d+", v):
            sys.exit("gen-width: a version is three numbers, e.g. 18.0.0")
    if a.check_libc:
        sys.exit(check_libc(a.version, a.check_libc, a.ucd))
    out = a.output or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "core", "src", "width.inc")
    write(a.version, a.floor, receivers, a.ucd, os.path.normpath(out))


if __name__ == "__main__":
    main()
