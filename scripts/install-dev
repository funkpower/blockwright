#!/usr/bin/env bash
# Build a Blockwright ref and install it as the dev build (run on the dev machine).
#
#   scripts/install-dev [--ref REF] [--prefix DIR] [--bin-dir DIR] [--apps-dir DIR]
#                       [--build-dir DIR] [--docs DIR] [--docs-ref REF | --no-help]
#                       [--check-paths]
#
#   --ref          commit-ish to build (default: origin/main, fetched first)
#   --prefix       install tree, below ~/.local/opt/ (default: ~/.local/opt/blockwright-dev)
#   --bin-dir      where the -dev symlinks go (default: ~/.local/bin)
#   --apps-dir     where the blockwright-dev.desktop launcher entry goes
#                  (default: ~/.local/share/applications)
#   --build-dir    source export + build tree, below ~/.cache/dw/
#                  (default: ~/.cache/dw/blockwright-dev-build)
#   --docs         the blockwright-docs checkout the help bundle is built from
#                  (default: blockwright-docs beside this repository)
#   --docs-ref     the docs commit to build it from (default: origin/main,
#                  fetched first)
#   --no-help      install without the help bundle (Help opens the website)
#   --check-paths  check the paths, print them and stop
#
# The script deletes inside the build dir and replaces the prefix, so both
# must resolve (symlinks followed) to below ~/.cache/dw/ and ~/.local/opt/,
# and those roots and the directories leading to them from $HOME must not be
# symlinks. --bin-dir and --apps-dir must resolve to below $HOME. Anything
# else is refused before a command runs.
#
# The ref is exported with `git archive`, so uncommitted changes in the
# working tree never reach the build. The exported files carry the commit's
# time, which can be older than objects built from another commit, so the
# build tree is wiped whenever the commit differs from the last one built
# there (recorded in <build-dir>/built-commit). Installs the GUI as
# blockwright-dev and the CLI as blockwright-cli-dev, with the licence and
# font notices in <prefix>/share/doc/blockwright/, and the launcher entry
# "Blockwright (dev)" (the commit in its Comment, the installed icon its Icon)
# as <apps-dir>/blockwright-dev.desktop. Unless --no-help, the help bundle
# (#210) is built from the docs (scripts/help-bundle, with the CLI and app
# just built) into <build-dir>/help and installed with them, so Help opens the
# tutorials and the manual offline; a docs build that fails stops the install
# and keeps the old dev build.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
ref=origin/main
prefix=$HOME/.local/opt/blockwright-dev
bin_dir=$HOME/.local/bin
apps_dir=$HOME/.local/share/applications
build_dir=$HOME/.cache/dw/blockwright-dev-build
check_only=
docs=$(dirname "$repo")/blockwright-docs
docs_ref=origin/main
no_help=

while [[ $# -gt 0 ]]; do
  case $1 in
    --ref) ref=$2; shift 2 ;;
    --prefix) prefix=$2; shift 2 ;;
    --bin-dir) bin_dir=$2; shift 2 ;;
    --apps-dir) apps_dir=$2; shift 2 ;;
    --build-dir) build_dir=$2; shift 2 ;;
    --docs) docs=$2; shift 2 ;;
    --docs-ref) docs_ref=$2; shift 2 ;;
    --no-help) no_help=1; shift ;;
    --check-paths) check_only=1; shift ;;
    -h|--help) sed -n '2,/^set -e/p' "$0" | sed '$d'; exit 0 ;;
    *) echo "install-dev: unknown argument $1" >&2; exit 2 ;;
  esac
done

# real_root <rel>: refuse if $HOME/<rel> or a directory between it and $HOME
# is a symlink, since the check below resolves the root it compares against
real_root() {
  local d=$HOME part
  local IFS=/
  for part in $1; do
    d=$d/$part
    if [[ -L $d ]]; then
      echo "install-dev: refusing to run: $d is a symlink" >&2; exit 2
    fi
  done
}

# resolve <path>: the absolute path, symlinks resolved, that need not exist
# (GNU realpath -m; macOS's realpath has no -m)
resolve() {
  if realpath -m / >/dev/null 2>&1; then
    realpath -m -- "$1"
  else
    python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
  fi
}

# below <name> <path> <root>: print <path> resolved, or refuse unless it is
# strictly below <root>
below() {
  local name=$1 path=$2 root
  root=$(resolve "$3")
  if [[ -z $path ]]; then
    echo "install-dev: refusing an empty $name" >&2; exit 2
  fi
  path=$(resolve "$path")
  if [[ $path != "$root"/?* ]]; then
    echo "install-dev: refusing $name $path: it must be below $root/" >&2; exit 2
  fi
  printf '%s\n' "$path"
}
real_root .cache/dw
real_root .local/opt
build_dir=$(below --build-dir "$build_dir" "$HOME/.cache/dw") || exit 2
prefix=$(below --prefix "$prefix" "$HOME/.local/opt") || exit 2
bin_dir=$(below --bin-dir "$bin_dir" "$HOME") || exit 2
apps_dir=$(below --apps-dir "$apps_dir" "$HOME") || exit 2
# The launcher entry's Exec line can't hold a line break
if [[ $bin_dir == *$'\n'* ]]; then
  echo "install-dev: refusing --bin-dir $bin_dir: it has a line break" >&2; exit 2
fi
if [[ $check_only ]]; then
  printf 'build-dir: %s\nprefix:    %s\nbin-dir:   %s\napps-dir:  %s\n' \
    "$build_dir" "$prefix" "$bin_dir" "$apps_dir"
  exit 0
fi

if [[ $ref == origin/* ]]; then
  GIT_ASKPASS=$repo/scripts/git-askpass git -C "$repo" fetch -q origin
fi
full=$(git -C "$repo" rev-parse "$ref^{commit}")
commit=$(git -C "$repo" rev-parse --short "$full")
echo "install-dev: building $ref ($commit)"

src=$build_dir/src
build=$build_dir/build
stamp=$build_dir/built-commit
if [[ ! -f $stamp || $(<"$stamp") != "$full" ]]; then
  rm -rf "$build" "$stamp"
fi
rm -rf "$src"
mkdir -p "$src" "$build"
git -C "$repo" archive "$full" | tar -x -C "$src"

# One configuration for configure, build and install, so they agree even
# under a multi-config generator
config=RelWithDebInfo
cmake -S "$src" -B "$build" -G Ninja \
  -DCMAKE_BUILD_TYPE="$config" \
  -DBUILD_TESTING=OFF \
  -DBLOCKWRIGHT_GIT_COMMIT="$commit" \
  -DCMAKE_INSTALL_PREFIX="$prefix" >/dev/null
nice -n 10 cmake --build "$build" --config "$config" -j 8
echo "$full" > "$stamp"

# The help bundle, from the docs at --docs-ref, rendered and listed by the
# programs just built; then the build is configured to install it
help=
if [[ -z $no_help ]]; then
  if [[ $docs_ref == origin/* ]]; then
    git -C "$docs" fetch -q origin
  fi
  help=$build_dir/help
  "$repo/scripts/help-bundle" --docs "$docs" --ref "$docs_ref" \
    --cli "$build/cli/blockwright-cli" --app "$build/app/blockwright" "$help"
fi
cmake -S "$src" -B "$build" -DBW_HELP_BUNDLE="$help" >/dev/null

# Install into a fresh tree beside the old one, then swap, so a failed
# install leaves the previous dev build working. <prefix>.new and .old sit
# beside the prefix, so they are below ~/.local/opt/ too.
stage=$prefix.new
rm -rf "$stage" "$prefix.old"
DESTDIR= cmake --install "$build" --config "$config" --prefix "$stage" >/dev/null
# The font's CC BY-SA 4.0, Unifont's and Noto Sans's OFL and the icons' MIT attribution have to ship with the binary
for f in LICENSE NOTICE oldschool-pc-fonts/LICENSE oldschool-pc-fonts/README.md \
         unifont/OFL-1.1.txt unifont/COPYING unifont/README.md \
         tabler-icons/LICENSE tabler-icons/README.md noto-sans/OFL.txt noto-sans/README.md; do
  if [[ ! -f $stage/share/doc/blockwright/$f ]]; then
    echo "install-dev: the install left out share/doc/blockwright/$f; keeping the old dev build" >&2
    rm -rf "$stage"; exit 1
  fi
done
for f in blockwright blockwright-cli; do
  if [[ ! -x $stage/bin/$f ]]; then
    echo "install-dev: the install left out bin/$f; keeping the old dev build" >&2
    rm -rf "$stage"; exit 1
  fi
done
# The app icon (#205), which the launcher entry names by its path; every
# install but a Mac's (Linux, FreeBSD) has the freedesktop icons
icon_rel=share/icons/hicolor/256x256/apps/blockwright.png
if [[ $(uname -s) != Darwin && ! -f $stage/$icon_rel ]]; then
  echo "install-dev: the install left out the icon ($icon_rel); keeping the old dev build" >&2
  rm -rf "$stage"; exit 1
fi
# The bundled Library (PLAN §12) ships with it
# (searched under the literal directory: the prefix may hold glob characters)
if [[ -z $(find "$stage/share/blockwright/library" -mindepth 2 -maxdepth 2 -name '*.ans' -print -quit 2>/dev/null) ]]; then
  echo "install-dev: the install left out the bundled library (share/blockwright/library/); keeping the old dev build" >&2
  rm -rf "$stage"; exit 1
fi
# and the sample projects (PLAN §12, Samples)
if [[ -z $(find "$stage/share/blockwright/samples" -mindepth 2 -maxdepth 2 -name manifest.json -print -quit 2>/dev/null) ]]; then
  echo "install-dev: the install left out the sample projects (share/blockwright/samples/); keeping the old dev build" >&2
  rm -rf "$stage"; exit 1
fi
# and the help bundle
if [[ -n $help && ! -f $stage/share/blockwright/help/bundle.json ]]; then
  echo "install-dev: the install left out the help bundle (share/blockwright/help/); keeping the old dev build" >&2
  rm -rf "$stage"; exit 1
fi
[[ -e $prefix ]] && mv "$prefix" "$prefix.old"
mv "$stage" "$prefix"
rm -rf "$prefix.old"

mkdir -p "$bin_dir"
ln -sfn "$prefix/bin/blockwright-cli" "$bin_dir/blockwright-cli-dev"
ln -sfn "$prefix/bin/blockwright" "$bin_dir/blockwright-dev"

# The launcher entry, written beside its final name and renamed into place.
# Exec quotes the path as the Desktop Entry spec says: inside the quotes
# \ " ` $ take a backslash, the value's own escaping then doubles every
# backslash, and % is written %%.
q=$bin_dir/blockwright-dev
q=${q//\\/\\\\}
q=${q//\"/\\\"}
q=${q//\`/\\\`}
q=${q//\$/\\\$}
q=${q//\\/\\\\}
q=${q//%/%%}
# Icon is a path, not a theme name, so the dev build's launcher shows the
# dev build's icon; in its value a backslash is written \\
icon=
if [[ -f $prefix/$icon_rel ]]; then
  icon=$prefix/$icon_rel
  icon=${icon//\\/\\\\}
fi
mkdir -p "$apps_dir"
desktop=$apps_dir/blockwright-dev.desktop
cat > "$desktop.new" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Blockwright (dev)
GenericName=ANSI art editor
Comment=Blockwright dev build $commit
Exec="$q" %f
Terminal=false
Categories=Graphics;2DGraphics;
DESKTOP
[[ -z $icon ]] || echo "Icon=$icon" >> "$desktop.new"
mv "$desktop.new" "$desktop"
echo "install-dev: launcher entry $desktop"
"$bin_dir/blockwright-dev" --version
"$bin_dir/blockwright-cli-dev" --version
