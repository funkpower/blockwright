#!/usr/bin/env bash
# Makes an .icns of a 1024 x 1024 PNG with the system's sips and iconutil:
#   make-icns <icon-1024.png> <out.icns>
set -euo pipefail
src=$1 out=$2
set=$(mktemp -d "${TMPDIR:-/tmp}/bw-icon.XXXXXX")/blockwright.iconset
trap 'rm -rf "$(dirname "$set")"' EXIT
mkdir "$set"
for s in 16 32 128 256 512; do
  sips -z "$s" "$s" "$src" --out "$set/icon_${s}x${s}.png" >/dev/null
  sips -z $((s * 2)) $((s * 2)) "$src" --out "$set/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns -o "$out" "$set"
