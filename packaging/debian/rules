#!/usr/bin/make -f

# Ubuntu builds with LTO by default, and with Ubuntu 26.04's GCC 15.2 and
# binutils 2.46 the render tests' link then misses symbols the static core
# library defines (without LTO, or with Fedora's, it links).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
include /usr/share/dpkg/buildopts.mk

# Builders have no network: the tests use the packaged Catch2 3, and with
# nocheck they aren't built at all.
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
BW_TESTING = -DBUILD_TESTING=OFF
endif

%:
	dh $@ --buildsystem=cmake+ninja

# The renderer's Unifont comes from the unifont package, not third_party/
override_dh_auto_configure:
	dh_auto_configure -- -DBW_FETCH_CATCH2=OFF -DBLOCKWRIGHT_SYSTEM_UNIFONT=/usr/share/unifont $(BW_TESTING)

override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen CTEST_OUTPUT_ON_FAILURE=1 \
	  CTEST_PARALLEL_LEVEL=$(or $(DEB_BUILD_OPTION_PARALLEL),1) dh_auto_test
