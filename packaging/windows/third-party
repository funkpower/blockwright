#!/usr/bin/env bash
# Writes the Windows package's THIRD-PARTY.txt for the Qt it bundles.
#
#   packaging/windows/third-party <qt-dir> <out-file>
#
# <qt-dir> is Qt for Windows (win64_llvm_mingw). Its version comes from
# lib/cmake/Qt6/Qt6ConfigVersion*.cmake and fills in @QT_VERSION@ and
# @QT_MINOR@ in packaging/windows/THIRD-PARTY.txt, so the notice and its
# source link name the Qt the package carries (packaging/qt-third-party).
# Fails, writing nothing, when the version can't be read or a placeholder is
# left over.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
qt=${1:?usage: third-party <qt-dir> <out-file>}
out=${2:?usage: third-party <qt-dir> <out-file>}
exec "$here/../qt-third-party" "$qt" "$here/THIRD-PARTY.txt" "$out"
