#!/usr/bin/env bash
# Builds the libraries Blockwright links besides Qt (zlib, zstd, libzip) for
# 64-bit Windows with llvm-mingw, static, into a prefix.
#
#   packaging/windows/build-deps <prefix> <work-dir>
#
# LLVM_MINGW names the llvm-mingw directory. The sources are downloaded into
# <work-dir>/src and checked against the hashes below; a file already there
# with the right hash is used as it is. A prefix that already holds a build
# of these versions is left alone.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
src_root=$(cd "$here/../.." && pwd)
prefix=${1:?usage: build-deps <prefix> <work-dir>}
work=${2:?usage: build-deps <prefix> <work-dir>}
: "${LLVM_MINGW:?set LLVM_MINGW to the llvm-mingw directory}"
jobs=${JOBS:-8}

# name version url sha256
deps=(
  "zlib 1.3.1 https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz 9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
  "zstd 1.5.7 https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
  "libzip 1.11.4 https://github.com/nih-at/libzip/releases/download/v1.11.4/libzip-1.11.4.tar.xz 8a247f57d1e3e6f6d11413b12a6f28a9d388de110adc0ec608d893180ed7097b"
)
stamp="$prefix/.bw-deps"
want=$(printf '%s\n' "${deps[@]}")
if [[ -f $stamp && $(cat "$stamp") == "$want" ]]; then
  echo "build-deps: $prefix is up to date"
  exit 0
fi

mkdir -p "$work/src" "$prefix"
prefix=$(cd "$prefix" && pwd)
toolchain="$src_root/cmake/toolchains/llvm-mingw-x86_64.cmake"
common=(-G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE="$toolchain"
        -DLLVM_MINGW="$LLVM_MINGW" -DCMAKE_INSTALL_PREFIX="$prefix" -DCMAKE_PREFIX_PATH="$prefix"
        -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON)

fetch() { # name version url sha256 -> unpacked source dir on stdout
  local file="$work/src/${3##*/}" dir="$work/src/$1-$2"
  if [[ ! -f $file ]] || ! echo "$4  $file" | sha256sum -c --status; then
    curl -sSfL -o "$file.part" "$3"
    echo "$4  $file.part" | sha256sum -c --status || { echo "build-deps: $3: checksum mismatch" >&2; exit 1; }
    mv "$file.part" "$file"
  fi
  rm -rf "$dir"
  mkdir -p "$dir"
  tar -xf "$file" -C "$dir" --strip-components=1
  echo "$dir"
}

build() { # source-dir build-dir cmake-args...
  local s=$1 b=$2; shift 2
  rm -rf "$b"
  cmake -S "$s" -B "$b" "${common[@]}" "$@" >/dev/null
  nice -n 10 cmake --build "$b" -j "$jobs" >/dev/null
  cmake --install "$b" >/dev/null
}

read -r n v u h <<<"${deps[0]}"; s=$(fetch "$n" "$v" "$u" "$h")
build "$s" "$work/build-$n" -DZLIB_BUILD_EXAMPLES=OFF
# zlib 1.3.1 installs both libzlib.a and libzlibstatic.a; keep the static one
# under the name FindZLIB looks for first.
cp "$prefix/lib/libzlibstatic.a" "$prefix/lib/libzlib.a"
rm -f "$prefix/lib/libzlib.dll.a" "$prefix/bin/libzlib.dll"

read -r n v u h <<<"${deps[1]}"; s=$(fetch "$n" "$v" "$u" "$h")
build "$s/build/cmake" "$work/build-$n" -DZSTD_BUILD_PROGRAMS=OFF -DZSTD_BUILD_TESTS=OFF \
  -DZSTD_BUILD_SHARED=OFF -DZSTD_BUILD_STATIC=ON -DZSTD_LEGACY_SUPPORT=OFF -DZSTD_MULTITHREAD_SUPPORT=OFF

read -r n v u h <<<"${deps[2]}"; s=$(fetch "$n" "$v" "$u" "$h")
build "$s" "$work/build-$n" -DBUILD_TOOLS=OFF -DBUILD_REGRESS=OFF -DBUILD_OSSFUZZ=OFF -DBUILD_EXAMPLES=OFF \
  -DBUILD_DOC=OFF -DENABLE_BZIP2=OFF -DENABLE_LZMA=OFF -DENABLE_ZSTD=OFF -DENABLE_OPENSSL=OFF \
  -DENABLE_GNUTLS=OFF -DENABLE_MBEDTLS=OFF -DENABLE_COMMONCRYPTO=OFF -DENABLE_WINDOWS_CRYPTO=OFF \
  -DZLIB_LIBRARY="$prefix/lib/libzlibstatic.a" -DZLIB_INCLUDE_DIR="$prefix/include"

# Their licences ship with the installer (they are linked into the binaries).
mkdir -p "$prefix/licenses"
cp "$work/src/zlib-1.3.1/LICENSE" "$prefix/licenses/zlib.txt"
cp "$work/src/zstd-1.5.7/LICENSE" "$prefix/licenses/zstd.txt"
cp "$work/src/libzip-1.11.4/LICENSE" "$prefix/licenses/libzip.txt"
echo "$want" >"$stamp"
echo "build-deps: built into $prefix"
